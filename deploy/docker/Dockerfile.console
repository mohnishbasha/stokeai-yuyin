# syntax=docker/dockerfile:1
# Console image (ARCHITECTURE 16.4). Builds the Next.js app with `output: "standalone"` and
# runs the traced server on distroless Node, as a non-root user, on port 3000.
FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS build
WORKDIR /src
COPY . .
RUN bun install --frozen-lockfile \
    && bun run --cwd apps/console build \
    && find apps/console/.next/standalone \( -iname 'sharp*' -o -iname '@img*' -o -iname '*libvips*' \) -prune -exec rm -rf {} +

FROM gcr.io/distroless/nodejs22-debian12:nonroot@sha256:13593b7570658e8477de39e2f4a1dd25db2f836d68a0ba771251572d23bb4f8e
ARG VERSION=0.0.0
ARG GIT_SHA=unknown
ARG SOURCE=https://github.com/mohnishbasha/stokeai-yuyin
ARG CREATED=unknown
LABEL org.opencontainers.image.title="yuyin-console" \
      org.opencontainers.image.description="Yuyin customer console" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.vendor="Serverless Ventures LLC" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary"
WORKDIR /app
# The standalone tree is rooted at the workspace root (outputFileTracingRoot), so the server is
# apps/console/server.js. Static assets and public files are not traced and are copied in.
COPY --from=build /src/apps/console/.next/standalone ./
COPY --from=build /src/apps/console/.next/static ./apps/console/.next/static
COPY --from=build /src/apps/console/public ./apps/console/public
COPY THIRD_PARTY_LICENSES.md EULA.md /licenses/
COPY apps/console/src/fonts/OFL-*.txt /licenses/fonts/
USER 65532:65532
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
# The image has no shell or curl, so the check runs Node itself against /healthz.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:3000/healthz').then((r)=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["apps/console/server.js"]
